{
  "rules": {
    "nicknames": {
      ".read": true,
      ".write": "auth != null"
    },
    "products": {
      ".read": true,
      ".write": "auth != null"
    },
    "productReviews": {
      ".read": true,
      ".write": "auth != null",
      "$productId": {
        ".read": true,
        ".write": "auth != null",
        ".indexOn": ["userId", "createdAt"]
      }
    },
    "popularProducts": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["score"]
    },
    ".read": "auth != null",
    ".write": "auth != null"
  }
}